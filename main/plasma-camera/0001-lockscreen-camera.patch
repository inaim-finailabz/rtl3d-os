diff -urN a/src/main.cpp b/src/main.cpp
--- a/src/main.cpp	2026-10-20 11:33:41
+++ b/src/main.cpp	2026-10-20 11:37:14
@@ -24,6 +24,57 @@
 
 #include "version.h"
 
+// RTL@3D: the lock-screen camera. Started as "plasma-camera --lockscreen" by
+// the lock screen's camera button, it asks KWin to show its window above the
+// lock screen (kde_lockscreen_overlay_v1, as Plasma Dialer does for calls).
+// In that mode it only takes photos and shows the ones taken now: no
+// settings, no gallery, no other app; it quits as soon as the phone unlocks.
+#include <QDBusConnection>
+#include <QDBusReply>
+#include <QDBusInterface>
+#include <QQuickWindow>
+#include <QWaylandClientExtensionTemplate>
+#include <qpa/qplatformnativeinterface.h>
+#include "qwayland-kde-lockscreen-overlay-v1.h"
+
+using namespace Qt::Literals::StringLiterals;
+
+class AboveLockScreen : public QWaylandClientExtensionTemplate<AboveLockScreen>, public QtWayland::kde_lockscreen_overlay_v1
+{
+public:
+    AboveLockScreen()
+        : QWaylandClientExtensionTemplate<AboveLockScreen>(1)
+    {
+        initialize();
+    }
+};
+
+static bool screenLocked()
+{
+    QDBusInterface saver(u"org.freedesktop.ScreenSaver"_s, u"/ScreenSaver"_s, u"org.freedesktop.ScreenSaver"_s);
+    QDBusReply<bool> reply = saver.call(u"GetActive"_s);
+    return reply.isValid() && reply.value();
+}
+
+// Must run before the window's first frame: KWin only lets a surface above the
+// lock screen if it is allowed while still unmapped.
+static bool allowAboveLockScreen(QWindow *window)
+{
+    static AboveLockScreen overlay;
+    if (!overlay.isInitialized()) {
+        qWarning() << "kde_lockscreen_overlay_v1 not available (is X-KDE-Wayland-Interfaces in the desktop file?)";
+        return false;
+    }
+    auto *native = qGuiApp->platformNativeInterface();
+    auto *surface = static_cast<wl_surface *>(native->nativeResourceForWindow("surface", window));
+    if (!surface) {
+        qWarning() << "no wl_surface for the camera window";
+        return false;
+    }
+    overlay.allow(surface);
+    return true;
+}
+
 using namespace Qt::Literals::StringLiterals;
 
 constexpr auto URI = "org.kde.plasmacamera";
