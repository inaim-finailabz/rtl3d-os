     }
 };
 
+/**
+ * Layout: PIN - RTL@3D, written by hand: the phone's PIN pad first, as on
+ * Plasma's lock screen, and "ABC" for the full US keyboard (letters, numbers,
+ * symbols), for a password that is not only digits.
+ **/
+
+static const char * const name_pin = "PIN";
+static const char * const short_name_pin = "pin";
+
+/* Layer 0: the PIN pad */
+
+static const uint32_t num_keys_pad_pin = 13;
+
+static const char * const keycaps_pad_pin[] = { \
+    "1", "2", "3", "\n", \
+    "4", "5", "6", "\n", \
+    "7", "8", "9", "\n", \
+    "ABC", "0", LV_SYMBOL_BACKSPACE, "\n", \
+    LV_SYMBOL_OK, "" \
+};
+
+static const lv_buttonmatrix_ctrl_t attributes_pad_pin[] = { \
+    LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, \
+    LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, \
+    LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, \
+    SQ2LV_CTRL_NON_CHAR | LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1, SQ2LV_CTRL_NON_CHAR | 1, \
+    SQ2LV_CTRL_NON_CHAR | LV_BUTTONMATRIX_CTRL_NO_REPEAT | 1 \
+};
+
+static const uint32_t switcher_idxs_pad_pin[] = { 9 };       /* ABC */
+static const int switcher_dests_pad_pin[] = { 1 };          /* letters */
+
+/* Layers 1-4: the US keyboard's, one place further (layer 0 is the pad) */
+static const int switcher_dests_lower_pin[] = { 2, 3 };     /* shift, 123 */
+static const int switcher_dests_upper_pin[] = { 1, 3 };
+static const int switcher_dests_numbers_pin[] = { 4, 1 };   /* symbols, ABC */
+static const int switcher_dests_symbols_pin[] = { 3, 1 };
+
+#define RTL3D_US_LAYER(NAME) { \
+        .num_keys = num_keys_##NAME##_us, \
+        .keycaps = keycaps_##NAME##_us, \
+        .attributes = attributes_##NAME##_us, \
+        .num_modifiers = num_modifiers_##NAME##_us, \
+        .modifier_idxs = modifier_idxs_##NAME##_us, \
+        .num_switchers = num_switchers_##NAME##_us, \
+        .switcher_idxs = switcher_idxs_##NAME##_us, \
+        .switcher_dests = switcher_dests_##NAME##_pin \
+    }
+
+static const int num_layers_pin = 5;
+
+static const sq2lv_layer_t layers_pin[] = {
+    {
+        .num_keys = num_keys_pad_pin,
+        .keycaps = keycaps_pad_pin,
+        .attributes = attributes_pad_pin,
+        .num_modifiers = 0,
+        .modifier_idxs = NULL,
+        .num_switchers = 1,
+        .switcher_idxs = switcher_idxs_pad_pin,
+        .switcher_dests = switcher_dests_pad_pin
+    },
+    RTL3D_US_LAYER(lower),
+    RTL3D_US_LAYER(upper),
+    RTL3D_US_LAYER(numbers),
+    RTL3D_US_LAYER(symbols)
+};
+
 /**
  * Public interface
  **/
 
-const int sq2lv_num_layouts = 4;
+const int sq2lv_num_layouts = 5;
 
 const sq2lv_layout_t sq2lv_layouts[] = {
     /* US English */
@@ -933,6 +1001,13 @@ const sq2lv_layout_t sq2lv_layouts[] = {
         .short_name = short_name_fr,
         .num_layers = num_layers_fr,
         .layers = layers_fr
+    },
+    /* PIN (RTL@3D) */
+    {
+        .name = name_pin,
+        .short_name = short_name_pin,
+        .num_layers = num_layers_pin,
+        .layers = layers_pin
     }
 };
 
@@ -940,10 +1015,12 @@ const char * const sq2lv_layout_names =
     "US English" "\n"
     "Deutsch" "\n"
     "Español" "\n"
-    "Français";
+    "Français" "\n"
+    "PIN";
 
 const char * const sq2lv_layout_short_names =
     "us" "\n"
     "de" "\n"
     "es" "\n"
-    "fr";
+    "fr" "\n"
+    "pin";
