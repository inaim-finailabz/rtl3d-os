pkgname=rtl3d-linux-support
pkgver=0.1.0
pkgrel=1
pkgdesc="OS-provided Linux backends for RTL@3D App Store entries"
url="https://github.com/inaim-finailabz/rtl3d-os"
arch="noarch"
license="GPL-3.0-or-later"
options="!check"
depends="
	python3
	openssl
	bubblewrap
	xdg-user-dirs
	glib
	flatpak
	zstd
	curl
	gpgv
	qt6-qtdeclarative
	qt6-qtquick3d
	qt6-qtmultimedia
	qt6-qtsvg
	qt6-qtimageformats
	qt6-qtwebengine
	waydroid
	ca-certificates
	xdg-desktop-portal
	xdg-desktop-portal-kde
	"
package() {
    mkdir -p "$pkgdir/usr/share/rtl3d"
    printf '%s\n' '0.1.0' > "$pkgdir/usr/share/rtl3d/linux-support-version"
}
