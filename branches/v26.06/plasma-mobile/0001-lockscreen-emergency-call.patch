RTL@3D: emergency calls from the lock screen, without the PIN.

A red "Emergency call" button under the keypad (above the keyboard in
password mode) opens EmergencyCall.qml: Call 999 / Call 112, speaker, hang
up, through RTL@3D's org.rtl3d.apps (rtl3d-admin emergency, which accepts
only 999, 112 and 911). Shown only when that module is installed. The
buttons are drawn here: the lock screen's button style ignores colours.

diff -ruN a/shell/contents/lockscreen/EmergencyCall.qml b/shell/contents/lockscreen/EmergencyCall.qml
--- a/shell/contents/lockscreen/EmergencyCall.qml	1970-01-01 01:00:00
+++ b/shell/contents/lockscreen/EmergencyCall.qml	2026-10-20 08:59:53
@@ -0,0 +1,135 @@
+// SPDX-FileCopyrightText: 2026 AI Labz Ltd
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// RTL@3D: emergency calls from the lock screen, without the PIN, as on every
+// phone. Only 999, 112 and 911 can be called (rtl3d-admin checks it again);
+// nothing else about the phone is reachable from here.
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.rtl3d.apps as RTL3D
+
+Rectangle {
+    id: root
+    color: Qt.rgba(0.05, 0.02, 0.02, 0.96)
+
+    signal closed()
+
+    property string state_: "idle"      // idle, dialing, ringing-out, active, terminated
+    property string number: ""
+    property string trouble: ""
+    property bool speaker: false
+    readonly property bool inCall: state_ !== "idle" && state_ !== "terminated"
+
+    RTL3D.Admin { id: admin }
+
+    // Buttons drawn here: the lock screen's button style ignores colours.
+    component Pill: Rectangle {
+        id: pill
+        property string text: ""
+        property color tint: "#d32f2f"
+        property real textSize: 18
+        signal clicked()
+        Layout.fillWidth: true
+        implicitHeight: Kirigami.Units.gridUnit * 3.5
+        radius: height / 2
+        color: pillTap.pressed ? Qt.darker(tint, 1.25) : tint
+        Label {
+            anchors.centerIn: parent
+            text: pill.text
+            color: "white"
+            font.bold: true
+            font.pointSize: pill.textSize
+        }
+        TapHandler { id: pillTap; onTapped: pill.clicked() }
+    }
+
+    Timer {
+        interval: 1500
+        repeat: true
+        running: root.number !== ""
+        onTriggered: admin.emergencyStatus(state => { root.state_ = state || "idle"; })
+    }
+
+    function dial(n) {
+        trouble = "";
+        number = n;
+        state_ = "dialing";
+        admin.emergency("call", n, err => {
+            if (err) { trouble = err; number = ""; state_ = "idle"; }
+        });
+    }
+
+    function hangUp() {
+        admin.emergency("hangup", "", () => { number = ""; state_ = "idle"; speaker = false; });
+    }
+
+    // Swallow every touch: nothing under the emergency screen is reachable.
+    MouseArea { anchors.fill: parent }
+
+    ColumnLayout {
+        anchors.centerIn: parent
+        width: Math.min(parent.width - Kirigami.Units.gridUnit * 2, Kirigami.Units.gridUnit * 18)
+        spacing: Kirigami.Units.gridUnit * 1.5
+
+        Label {
+            Layout.alignment: Qt.AlignHCenter
+            text: root.inCall ? (root.state_ === "active" ? "In call: " : "Calling ") + root.number : "Emergency call"
+            color: "white"
+            font.pointSize: 20
+            font.bold: true
+        }
+
+        Label {
+            Layout.fillWidth: true
+            visible: root.trouble !== ""
+            text: root.trouble
+            color: "#ffb3b3"
+            wrapMode: Text.Wrap
+            horizontalAlignment: Text.AlignHCenter
+        }
+
+        Repeater {
+            model: ["999", "112"]
+            delegate: Pill {
+                required property string modelData
+                visible: !root.inCall
+                implicitHeight: Kirigami.Units.gridUnit * 4
+                text: "Call " + modelData
+                textSize: 22
+                onClicked: root.dial(modelData)
+            }
+        }
+
+        RowLayout {
+            visible: root.inCall
+            Layout.fillWidth: true
+            spacing: Kirigami.Units.gridUnit
+
+            Pill {
+                text: root.speaker ? "Speaker off" : "Speaker on"
+                tint: "#455a64"
+                onClicked: {
+                    root.speaker = !root.speaker;
+                    admin.emergency("speaker", root.speaker ? "on" : "off", () => {});
+                }
+            }
+            Pill {
+                text: "Hang up"
+                onClicked: root.hangUp()
+            }
+        }
+
+        Pill {
+            visible: !root.inCall
+            text: "Cancel"
+            tint: "#455a64"
+            textSize: 14
+            implicitHeight: Kirigami.Units.gridUnit * 2.6
+            onClicked: root.closed()
+        }
+    }
+}
diff -ruN a/shell/contents/lockscreen/Keypad.qml b/shell/contents/lockscreen/Keypad.qml
--- a/shell/contents/lockscreen/Keypad.qml	2026-10-20 08:59:53
+++ b/shell/contents/lockscreen/Keypad.qml	2026-10-20 08:59:53
@@ -237,4 +237,57 @@
             }
         }
     }
+
+    // RTL@3D: emergency calls without the PIN. The button shows only where
+    // RTL@3D's module is installed; without it the lock screen is unchanged.
+    property bool emergencyAvailable: false
+    Component.onCompleted: {
+        try {
+            const probe = Qt.createQmlObject("import org.rtl3d.apps; Admin {}", root, "emergencyProbe");
+            probe.destroy();
+            root.emergencyAvailable = true;
+        } catch (e) {
+            root.emergencyAvailable = false;
+        }
+    }
+
+    // A red pill, drawn here: the lock screen's button style ignores colours.
+    // Below the keypad; above the on-screen keyboard in password mode.
+    Rectangle {
+        id: emergencyButton
+        visible: root.emergencyAvailable && root.openProgress >= 0.8
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: lockScreenState.isKeyboardMode ? Kirigami.Units.gridUnit * 3
+                                          : parent.height - height - Kirigami.Units.gridUnit * 2
+        width: emergencyLabel.implicitWidth + Kirigami.Units.gridUnit * 2.5
+        height: Kirigami.Units.gridUnit * 2.6
+        radius: height / 2
+        color: emergencyTap.pressed ? "#b71c1c" : "#d32f2f"
+
+        Label {
+            id: emergencyLabel
+            anchors.centerIn: parent
+            text: "Emergency call"
+            color: "white"
+            font.bold: true
+            font.pointSize: 12
+        }
+        TapHandler {
+            id: emergencyTap
+            onTapped: emergencyLoader.active = true
+        }
+    }
+
+    Loader {
+        id: emergencyLoader
+        anchors.fill: parent
+        z: 100
+        active: false
+        source: "EmergencyCall.qml"
+        Connections {
+            target: emergencyLoader.item
+            ignoreUnknownSignals: true
+            function onClosed() { emergencyLoader.active = false; }
+        }
+    }
 }
