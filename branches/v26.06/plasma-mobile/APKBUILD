# RTL@3D OS, v26.06 (Alpine 3.24): Alpine's 3.24-stable plasma-mobile with
# RTL@3D's lock screen patches; pkgrel 100 sorts above Alpine's own build.
maintainer="AI Labz Ltd <hello@finailabz.com>"
pkgname=plasma-mobile
pkgver=6.6.6
pkgrel=102
pkgdesc="Modules providing phone functionality for Plasma"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://www.plasma-mobile.org/"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
options="!check"
depends="
	bluez-qt
	breeze-icons
	dbus-x11
	kpipewire
	kquickcharts
	plasma-activities
	plasma-keyboard
	plasma-nano
	plasma-nm
	plasma-pa
	plasma-settings
	plasma-workspace
	qqc2-breeze-style
	"
makedepends="
	extra-cmake-modules
	kauth-dev
	kbookmarks-dev
	kcodecs-dev
	kcompletion-dev
	kconfig-dev
	kconfigwidgets-dev
	kcoreaddons-dev
	kdbusaddons-dev
	kdeclarative-dev
	ki18n-dev
	kio-dev
	kirigami-addons-dev
	kitemviews-dev
	kjobwidgets-dev
	knotifications-dev
	kpackage-dev
	kpeople-dev
	kservice-dev
	kwayland-dev
	kwidgetsaddons-dev
	kwin-dev
	kwindowsystem-dev
	kxmlgui-dev
	libphonenumber-dev
	libplasma-dev
	modemmanager-qt-dev
	networkmanager-qt-dev
	plasma-activities-dev
	plasma-workspace-dev
	qcoro-dev
	qt6-qtdeclarative-dev
	samurai
	solid-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-lang
	$pkgname-systemd
	$pkgname-waydroid
	"
provides="plasma-phone-components=$pkgver-r$pkgrel" # For backwards compatibility
replaces="plasma-phone-components" # For backwards compatibility


case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac
_repo_url="https://invent.kde.org/plasma/plasma-mobile.git"
source="https://download.kde.org/$_rel/plasma/$pkgver/plasma-mobile-$pkgver.tar.xz
	99-flashlight.rules
	0001-lockscreen-emergency-call.patch
	0002-lockscreen-camera.patch
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DINSTALL_SYSTEMD_SERVICE=ON
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 "$srcdir"/99-flashlight.rules -t "$pkgdir"/usr/lib/udev/rules.d/
}

waydroid() {
	pkgdesc="$pkgdesc - Waydroid integration"
	install_if="$pkgname=$pkgver-r$pkgrel waydroid"

	amove usr/lib/libexec/kf6/kauth/waydroidhelper
	amove usr/lib/qt6/plugins/plasma/kcms/systemsettings/kcm_waydroidintegration.so
	amove usr/lib/qt6/qml/org/kde/plasma/private/mobileshell/waydroidintegrationplugin
	amove usr/share/applications/kcm_waydroidintegration.desktop
	amove usr/share/dbus-1/system-services/*waydroidhelper.service
	amove usr/share/dbus-1/system.d/*waydroidhelper.conf
	amove usr/share/plasma/quicksettings/*waydroid
	amove usr/share/polkit-1/actions/*waydroidhelper.policy
}

